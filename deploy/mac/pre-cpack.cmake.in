set(_ieum_app
  "${CPACK_TEMPORARY_INSTALL_DIRECTORY}/@CMAKE_PROJECT_PROPER_NAME@.app"
)
set(_ieum_core
  "${_ieum_app}/Contents/MacOS/@CMAKE_PROJECT_NAME@-core"
)

if(NOT IS_DIRECTORY "${_ieum_app}")
  message(FATAL_ERROR "Staged macOS app bundle was not found: ${_ieum_app}")
endif()
if(NOT EXISTS "${_ieum_core}")
  message(FATAL_ERROR "Staged macOS core executable was not found: ${_ieum_core}")
endif()

message(STATUS "Deploying Qt dependencies into ${_ieum_app}")
execute_process(
  COMMAND
    "@DEPLOYQT@"
    "${_ieum_app}"
    "-executable=${_ieum_core}"
    "-no-codesign"
  COMMAND_ECHO STDOUT
  COMMAND_ERROR_IS_FATAL ANY
)

# macdeployqt uses -executable to rewrite an auxiliary executable's Qt load
# paths, but it does not include that executable in its signing pass. Sign the
# core after those rewrites so the outer app seal can include valid nested code.
set(_ieum_signing_identity "@APPLE_CODESIGN_DISTRIBUTION@")
set(_ieum_core_codesign /usr/bin/codesign --force)
if(_ieum_signing_identity)
  list(
    APPEND
    _ieum_core_codesign
    --options
    runtime
    --timestamp
    --sign
    "${_ieum_signing_identity}"
  )
else()
  list(APPEND _ieum_core_codesign --sign -)
endif()
list(APPEND _ieum_core_codesign "${_ieum_core}")

message(STATUS "Signing auxiliary core executable ${_ieum_core}")
execute_process(
  COMMAND ${_ieum_core_codesign}
  COMMAND_ECHO STDOUT
  COMMAND_ERROR_IS_FATAL ANY
)

message(STATUS "Sealing ${_ieum_app}")
execute_process(
  COMMAND
    "@DEPLOYQT@"
    "${_ieum_app}"
    "@IEUM_MACDEPLOYQT_SIGN_ARGUMENT@"
  COMMAND_ECHO STDOUT
  COMMAND_ERROR_IS_FATAL ANY
)

# A successful macdeployqt exit is not enough. Any file added after signing
# breaks the outer bundle seal, which Gatekeeper reports as a damaged app.
execute_process(
  COMMAND
    /usr/bin/codesign
    --verify
    --deep
    --strict
    --verbose=2
    "${_ieum_app}"
  COMMAND_ECHO STDOUT
  COMMAND_ERROR_IS_FATAL ANY
)
